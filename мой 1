<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Фиолетовый блестящий фон</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      overflow: hidden;
      background: linear-gradient(135deg, #1a0033, #2d0066, #4b0082, #6a0dad, #8a2be2);
      background-size: 400% 400%;
      animation: gradientShift 12s ease infinite;
      position: relative;
      font-family: system-ui, sans-serif;
      color: white;
    }

    /* Плавное движение градиента */
    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Слой с бликами */
    .shine {
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(circle at 20% 30%, rgba(255, 200, 255, 0.25) 0%, transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(180, 100, 255, 0.3) 0%, transparent 45%),
        radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.08) 0%, transparent 60%);
      animation: shineMove 8s ease-in-out infinite alternate;
      pointer-events: none;
    }

    @keyframes shineMove {
      0% { transform: scale(1) translate(0, 0); opacity: 0.8; }
      100% { transform: scale(1.15) translate(-30px, 20px); opacity: 1; }
    }

    /* Блестки (частицы) */
    .sparkle {
      position: absolute;
      width: 4px;
      height: 4px;
      background: white;
      border-radius: 50%;
      box-shadow: 0 0 6px 2px rgba(255, 200, 255, 0.8);
      animation: sparkle 3s linear infinite;
      pointer-events: none;
    }

    @keyframes sparkle {
      0% {
        transform: translateY(0) scale(0);
        opacity: 0;
      }
      20% {
        opacity: 1;
        transform: scale(1);
      }
      80% {
        opacity: 1;
      }
      100% {
        transform: translateY(-100vh) scale(0);
        opacity: 0;
      }
    }

    /* Контент по центру (можешь заменить на свой) */
    .content {
      position: relative;
      z-index: 10;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 20px;
    }

    h1 {
      font-size: clamp(2rem, 6vw, 4rem);
      font-weight: 700;
      text-shadow: 0 0 20px rgba(200, 100, 255, 0.8), 0 0 40px rgba(150, 50, 255, 0.5);
      margin-bottom: 16px;
    }

    p {
      font-size: 1.2rem;
      opacity: 0.9;
      max-width: 500px;
    }
  </style>
</head>
<body>
  <div class="shine"></div>

  <!-- Контент сайта (замени на свой) -->
  <div class="content">
    <h1>Фиолетовый блеск</h1>
    <p>Красивый анимированный фон с бликами и блёстками</p>
  </div>

  <script>
    // Создаём блёстки
    function createSparkles() {
      const count = 40; // количество блёсток

      for (let i = 0; i < count; i++) {
        const sparkle = document.createElement('div');
        sparkle.classList.add('sparkle');

        // Случайная позиция и размер
        sparkle.style.left = Math.random() * 100 + 'vw';
        sparkle.style.top = Math.random() * 100 + 'vh';
        sparkle.style.width = sparkle.style.height = (Math.random() * 3 + 2) + 'px';

        // Случайная задержка и длительность
        sparkle.style.animationDelay = Math.random() * 5 + 's';
        sparkle.style.animationDuration = (Math.random() * 3 + 3) + 's';

        document.body.appendChild(sparkle);
      }
    }

    createSparkles();
  </script>
</body>
</html>
